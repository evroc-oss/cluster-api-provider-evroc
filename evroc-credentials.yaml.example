# evroc CAPI Provider Credentials
# Copy this file and fill in your values:
#   cp evroc-credentials.yaml.example evroc-credentials.yaml
#   # Edit evroc-credentials.yaml with your credentials
#   kubectl create secret generic evroc-credentials \
#     --from-file=config.yaml=evroc-credentials.yaml \
#     -n capi-evroc-system

# --- Option A: OAuth2 tokens (recommended for automation/CI) ---
auth:
  token: "your-access-token"
  refresh_token: "your-refresh-token"

# --- Option B: Username and password (for interactive/development use) ---
# auth:
#   username: "your-username"
#   password: "your-password"

# Context (required)
context:
  project: "your-project-id"
  region: "se-sto"  # or other evroc region
