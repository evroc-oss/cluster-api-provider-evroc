# evroc CAPI Provider Credentials
# Copy this file and fill in your values:
#   cp evroc-credentials.yaml.example evroc-credentials.yaml
#   # Edit evroc-credentials.yaml with your credentials
#   kubectl create secret generic evroc-credentials \
#     --from-file=config.yaml=evroc-credentials.yaml \
#     -n capi-evroc-system

# Service account authentication (required)
# See README.md "Create a service account" (step 6) for setup instructions.
auth:
  service_account_id: "your-service-account-name"
  service_account_secret: "your-base64-encoded-jwk-private-key"

# Context (optional — project and region come from the EvrocCluster spec)
context:
  organization: "your-organization-id"  # optional
