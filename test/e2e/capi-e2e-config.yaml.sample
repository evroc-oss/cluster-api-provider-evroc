# CAPI QuickStart E2E Test Configuration (SAMPLE)
#
# Copy this file to capi-e2e-config.yaml and fill in the values marked below.
# The real config is git-ignored because it holds account-specific values
# (project ID, SSH key). CAPI E2E tests are run locally, so each developer
# supplies their own copy.
#
# Used for upstream CAPI E2E certification tests (QuickStart spec)
# See: https://cluster-api.sigs.k8s.io/developer/core/e2e
#
# Estimated durations (real evroc infrastructure, se-sto region):
#   Full suite:          ~45-55 min
#   BeforeSuite:         ~1-2 min   (kind cluster + clusterctl init)
#   QuickStart:          ~6 min     (1 CP + 1 worker = 2 VMs, 1 LB, 1 public IP)
#   ClusterctlMove:      ~15 min    (1 CP + 1 worker + 1 bastion = 3 VMs, 1 LB, 1 public IP)
#   HA-LB (kubeadm):     ~14 min    (3 CP = 3 VMs, 1 LB, 1 public IP)
#   HA-LB (RKE2):        ~15 min    (3 CP = 3 VMs, 1 LB, 1 public IP)
#   Webhook Validation:  <1 min     (in-cluster kubectl apply tests, no cloud resources)
#   Provider Install:    <1 min     (verify CRDs and deployment, no cloud resources)
#
# Peak resource usage: ~8 VMs, 3 LBs, 3 public IPs (if tests overlap)
# Tests clean up resources on completion. Interrupted runs may leave orphans.

managementClusterName: evroc-capi-quickstart

images: []

intervals:
  default/wait-controllers: ["15m", "10s"]
  default/wait-cluster: ["35m", "30s"]
  default/wait-delete-cluster: ["20m", "30s"]
  default/wait-machines: ["20m", "30s"]
  default/wait-move: ["10m", "30s"]

variables:
  NAMESPACE: "default"
  KUBERNETES_VERSION: "v1.28.0"
  EVROC_PROVIDER_VERSION: "latest"
  CONTROL_PLANE_MACHINE_COUNT: "1"
  WORKER_MACHINE_COUNT: "1"
  EVROC_AVAILABILITY_ZONE: "a"
  EVROC_REGION: "se-sto"
  # Endpoint overrides. Leave empty to run against the public evroc cloud.
  # To target another environment, copy apiURL/issuerURL from the matching
  # profile in ~/.evroc/config.yaml, e.g.:
  #   EVROC_API_BASE_URL: "https://api.<env>.example.com"
  #   EVROC_ISSUER_URL: "https://authn.<env>.example.com/realms/evroc-customer"
  # The service account, project and organization must all belong to that same
  # environment — a mismatch only surfaces as an auth failure at reconcile time.
  EVROC_API_BASE_URL: ""
  EVROC_ISSUER_URL: ""
  EVROC_CONTROL_PLANE_FLAVOR: "a1a.s"
  EVROC_IMAGE: "ubuntu.22-04.1"
  EVROC_CONTROL_PLANE_DISK_SIZE: "100"
  # evroc project/credentials (loaded from config.yaml by loadCredentialsFile, duplicated here as fallback)
  EVROC_PROJECT: "<your-evroc-project-uuid>"
  EVROC_CREDENTIALS_SECRET: "evroc-credentials"
  EVROC_SSH_KEY: "<your-ssh-public-key>"
  # Custom VPC/subnet for the dual-stack E2E path. OPTIONAL: when unset, the
  # controller uses the project's default VPC and the per-zone default subnet
  # (default-{region}-{zone}).
  #
  # These reference PRE-EXISTING resources — nothing in this repo creates them.
  # To run the dual-stack path, first create a VPC + subnet, then set these to
  # their names (see test/e2e/README.md "Custom VPC / dual-stack" for details):
  #
  #   evroc networking vpc create capi-e2e-dualstack --stack-type=dual-stack \
  #     --ipv4-cidr-block=10.0.0.0/16
  #   evroc networking subnet create capi-e2e-ds-a --stack-type=dual-stack \
  #     --ipv4-cidr-block=10.0.5.0/24 --vpc=capi-e2e-dualstack --zone=a
  #
  # EVROC_VPC_REF: "capi-e2e-dualstack"
  # EVROC_SUBNET_A: "capi-e2e-ds-a"
