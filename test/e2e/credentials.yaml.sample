# Copy this file to credentials.yaml and fill in your evroc credentials:
#   cp test/e2e/credentials.yaml.sample test/e2e/credentials.yaml
#
# This file contains credentials in the SDK format that can be directly
# used by the cluster-api-provider-evroc controller.

# REQUIRED: Service account authentication
auth:
  service_account_id: ""     # Your service account name
  service_account_secret: "" # Your service account private key (base64-encoded JWK)

# Optional context (project and region come from the EvrocCluster spec)
context:
  organization: ""  # Your evroc organization ID
