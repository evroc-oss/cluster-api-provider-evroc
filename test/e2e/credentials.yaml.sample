# Copy this file to credentials.yaml and fill in your evroc credentials:
#   cp test/e2e/credentials.yaml.sample test/e2e/credentials.yaml
#
# This file contains credentials in the SDK format that can be directly
# used by the cluster-api-provider-evroc controller.

# REQUIRED: Choose ONE authentication method (tokens OR username/password)
auth:
  # Option A: Token-based authentication (recommended for automation/CI)
  token: ""         # Your access token
  refresh_token: "" # Your refresh token

  # Option B: Username/password authentication (for interactive/development use)
  # Uncomment and use these instead of tokens if preferred:
  # username: ""    # Your evroc username/email
  # password: ""    # Your evroc password

# REQUIRED: Project, organization, and region context
context:
  project: ""       # REQUIRED: Your evroc project ID
  region: "se-sto"  # REQUIRED: evroc region (e.g., se-sto, no-osl)
  organization: ""  # REQUIRED: Your evroc organization ID
